# Publication allowlist: only what builds the APK from the original game files is tracked.
# Local files, build outputs, research notes and new top-level folders stay private.
/*
!/.gitignore
!/.gitattributes
!/.gitmodules
!/readme.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/requirements.txt
!/dependencies.json
!/dependencies-audio.json
!/dependencies-dxvk.json
!/dependencies-host.json
!/dependencies-turnip.json
!/dependencies-textures.json
!/dependencies-fsr.json

!/android/
/android/**
!/android/**/
!/android/**/*.c
!/android/**/*.h
!/android/**/*.cpp
!/android/**/*.inc
!/android/**/*.java
!/android/**/*.xml
!/android/**/*.uc
!/android/**/*.ini
!/android/**/*.json
!/android/**/*.py
!/android/**/*.md
!/android/**/*.yml
!/android/**/*.comp
!/android/launcher/.gitignore

!/config/
/config/*
!/config/inputs.json
!/config/modules.json

!/tools/
/tools/*
!/tools/*.py

!/tests/
/tests/*
!/tests/*.c
!/tests/*.h
!/tests/*.cpp
!/tests/*.inc
!/tests/*.hlsl
!/tests/*.py
!/tests/uscript/
!/tests/uscript/AndroidPortChecks/
!/tests/uscript/AndroidPortChecks/Classes/
!/tests/uscript/AndroidPortChecks/Classes/*.uc

!/reference/
/reference/*
!/reference/dlmalloc/
!/reference/mojoshader/
!/reference/pcrecomp/
!/reference/homm5/
!/reference/adrenotools/
!/reference/turnip-android/
!/reference/audio-runtime/
!/reference/dxvk-runtime/
!/reference/dxvk/
!/reference/astcenc/
!/reference/etcpak/
/reference/dxvk/**
!/reference/dxvk/**/
!/reference/dxvk/LICENSE
!/reference/dxvk/include/native/**
!/reference/dxvk/include/vulkan/LICENSE.md
!/reference/dxvk/include/vulkan/include/vulkan/*.h
!/reference/dxvk/include/vulkan/include/vk_video/*.h

# Defense in depth for outputs, credentials and machine settings in source trees.
**/__pycache__/
**/build/
**/.gradle/
**/.idea/
**/.vscode/
*.py[cod]
*.apk
*.aab
*.exe
*.dll
*.so
*.o
*.obj
*.a
*.class
*.dex
*.zip
*.7z
*.tar.gz
*.log
*.keystore
*.jks
*.pem
*.key
.env
.env.*
local.properties
STATE.md
AGENTS.md

# The pinned prebuilt runtimes the APK packages (hash-pinned in dependencies-*.json).
!/reference/audio-runtime/arm64-v8a/*.so
!/reference/dxvk-runtime/*.so
!/reference/turnip-android/*.so

!/reference/fsr1/
!/reference/fsr1/ffx_fsr1.h
!/reference/fsr1/FSR1-MIT.txt
!/reference/fsr3-runtime/
/reference/fsr3-runtime/**
!/reference/fsr3-runtime/include/
!/reference/fsr3-runtime/include/**/
!/reference/fsr3-runtime/include/**/*.h
!/reference/fsr3-runtime/lib/
!/reference/fsr3-runtime/lib/libffx_backend_vk_android_arm64.a
!/reference/fsr3-runtime/lib/libffx_frameinterpolation_android_arm64.a
!/reference/fsr3-runtime/lib/libffx_opticalflow_android_arm64.a
!/reference/fsr3-runtime/FSR3-Android-MIT.txt
