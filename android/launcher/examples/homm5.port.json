{
  "schema": 1,
  "app": {
    "label": "Heroes V",
    "title": "Heroes of Might and Magic V",
    "subtitle": "Heroes V / Hammers of Fate / Tribes of the East",
    "logTag": "HeroesV",
    "storage": "HeroesV",
    "github": "phys-winner/pc_decomp_homm5",
    "languages": ["en", "ru"],
    "allFilesAccess": true,
    "localNetwork": true,
    "autoLaunch": true,
    "processes": {"launcher": ":launcher"},
    "mountSidecarLimitMB": 256
  },
  "theme": {
    "background": ["#142230", "#0A1018", "#020305"],
    "card": "#EB16141A",
    "cardStroke": "#6EEBCB7F",
    "cell": "#2E2C34",
    "accent": "#EBCB7F",
    "accentDark": "#A07828",
    "primaryFill": "#402C0E",
    "text": "#FFFFFF",
    "muted": "#A5A5B2",
    "error": "#FF7D6E",
    "titleFont": "serif-bold"
  },
  "distributions": [
    {
      "id": "toe",
      "title": {"en": "Tribes of the East", "ru": "Повелители Орды"},
      "version": "3.1",
      "activity": "org.homm5.port.GameActivity",
      "renderers": ["gles", "dxvk", "turnip"],
      "intro": {"default": true},
      "parts": [
        {
          "id": "game",
          "title": {"en": "Game files", "ru": "Файлы игры"},
          "folder": "{storage}/game",
          "marker": "bin/H5_Game.exe",
          "required": ["bin/H5_Game.exe", "data/data.pak", "data/a2p1-data.pak"],
          "needed": ["bin/", "data/", "music/", "video/", "profiles/", "maps/", "usercampaigns/", "usermods/",
                     "hwcursors/", "duelpresets/"],
          "mount": true
        }
      ]
    },
    {
      "id": "hof",
      "title": {"en": "Hammers of Fate", "ru": "Владыки Севера"},
      "version": "2.1",
      "activity": "org.homm5.port.HofGameActivity",
      "renderers": ["gles"],
      "intro": {"default": true},
      "parts": [
        {
          "id": "game",
          "folder": "{storage}/game",
          "marker": "bina1/H5_Game.exe",
          "required": ["bina1/H5_Game.exe", "data/data.pak", "dataa1/a1-data.pak", "dataa1/a1p1-data.pak"],
          "needed": ["bin/", "bina1/", "data/", "dataa1/", "music/", "video/", "profiles/", "maps/", "usermods/", "hwcursors/"]
        }
      ]
    },
    {
      "id": "vanilla",
      "title": "Heroes of Might and Magic V",
      "version": "1.6",
      "activity": "org.homm5.port.VanillaGameActivity",
      "renderers": ["gles"],
      "intro": {"default": true},
      "parts": [
        {
          "id": "game",
          "folder": "{storage}/game",
          "marker": "bin/H5_Game.exe",
          "required": ["bin/H5_Game.exe", "data/data.pak", "data/p3c-data.pak", "DataLS/p6-data.pak"],
          "needed": ["bin/", "data/", "datals/", "music/", "video/", "profiles/", "maps/", "usermods/", "hwcursors/"]
        }
      ]
    }
  ],
  "renderers": {
    "default": "gles",
    "modes": [
      {"id": "gles", "kind": "gles", "title": "OpenGL ES",
       "description": {"en": "The port's own Direct3D 9 on OpenGL ES 3.2: works everywhere.",
                       "ru": "Собственный рендерер порта: Direct3D 9 на OpenGL ES 3.2, работает везде."}},
      {"id": "dxvk", "kind": "vulkan", "title": "DXVK (Vulkan)", "vulkan": "1.3", "minSdk": 30,
       "libraries": ["libh5dxvk.so", "libdxvk_d3d9.so", "libc++_shared.so"]},
      {"id": "turnip", "kind": "turnip", "title": "DXVK (Turnip)", "vulkan": "1.3", "minSdk": 30, "adreno": [600, 799],
       "driver": "libh5turnip.so",
       "libraries": ["libh5dxvk.so", "libdxvk_d3d9.so", "libc++_shared.so", "libadrenotools.so", "libh5turnip.so"]}
    ]
  },
  "options": [
    {"key": "new_creature_framework", "type": "bool", "default": "0", "only": ["toe"],
     "title": "Tribes of the East: New Creature Framework",
     "hint": {"en": "MMH5.5 patches: creature limit 999 for mods with new creatures. Only with such a mod installed.",
              "ru": "Патчи MMH5.5: лимит существ 999 для модов с новыми существами. Только с установленным модом."}},
    {"key": "lan_peers", "type": "text", "default": "", "only": ["toe"],
     "title": {"en": "LAN over Tailscale/VPN: players", "ru": "LAN через Tailscale/VPN: игроки"},
     "hint": {"en": "Tailscale (100.x.y.z) addresses or MagicDNS names of the other players.",
              "ru": "Адреса Tailscale (100.x.y.z) или имена MagicDNS других игроков."}}
  ],
  "cleanup": {
    "categories": [
      {"id": "editor", "part": "game", "title": {"en": "Map editor", "ru": "Редактор карт"},
       "globs": ["editor/", "bin/H5_MapEditor.exe", "bina1/H5_MapEditor.exe"]},
      {"id": "installers", "part": "game", "title": {"en": "Installers and redistributables", "ru": "Установщики и библиотеки Windows"},
       "globs": ["unins*", "directx/", "_commonredist/", "redist/", "vcredist*", "*.msi"]},
      {"id": "docs", "part": "game", "title": {"en": "Manuals", "ru": "Руководства"}, "globs": ["*.pdf", "manual/", "*.rtf"]}
    ]
  },
  "textures": {"backend": "org.homm5.port.TexconvBackend"},
  "hints": {
    "gameFiles": {"en": "A ZIP archive of the installed game or its folder: the one with bin and data (bina1/dataa1 for Hammers of Fate).",
                  "ru": "ZIP-архив установленной игры или папка установки — та, где лежат bin и data (для Hammers of Fate также bina1/dataa1)."}
  }
}
