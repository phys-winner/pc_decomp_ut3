#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0) uniform isampler2D opticalFlow;
layout(set=0,binding=1) uniform sampler2D sceneDepth;
layout(set=0,binding=2,rg16f) writeonly uniform image2D motion;
layout(set=0,binding=3,r32f) writeonly uniform image2D depth;
layout(push_constant) uniform Params { vec4 sceneRect; vec2 outputSize; } params;
void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(p,ivec2(params.outputSize)))) return;
    ivec2 block=clamp(p/8,ivec2(0),textureSize(opticalFlow,0)-1);
    vec2 flow=vec2(texelFetch(opticalFlow,block,0).xy)/params.outputSize;
    ivec2 samplePosition=ivec2(params.sceneRect.xy+(vec2(p)+0.5)*params.sceneRect.zw/params.outputSize);
    samplePosition=clamp(samplePosition,ivec2(0),textureSize(sceneDepth,0)-1);
    imageStore(motion,p,vec4(flow,0,0));
    imageStore(depth,p,vec4(texelFetch(sceneDepth,samplePosition,0).r,0,0,0));
}
