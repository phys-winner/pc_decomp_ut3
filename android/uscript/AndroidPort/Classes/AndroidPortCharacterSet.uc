/**
 * The per-character rule of the original UIEditBox.CharacterSet (UT3.exe IsValidCharacter,
 * 0x00FE2130, called only by ProcessInputChar 0x00FF1A40 for typed characters; SetValue and
 * SetUserText do not filter). The port's text dialog commits a whole string through SetUserText,
 * so it drops what the field would not have taken while typing, as the original does.
 *
 * Values of EEditBoxCharacterSet: 0 All, 1 NoSpecial, 2 AlphaOnly, 3 NumericOnly, 4 AlphaNumeric;
 * others accept nothing. Each UTF-16 unit is checked on its own (one WM_CHAR each).
 * Generated by build/review-fixes/r6/gen_characterset.py from the measured tables.
 */
class AndroidPortCharacterSet extends Object
    abstract;

/** Latin-1 letters as the original takes them (0x0046E140): A-Z, a-z, U+00C0-00FF and 0x8C, 0x9C, 0x9F. */
static function bool IsAlpha(int C)
{
    return (C >= 65 && C <= 90) || (C >= 97 && C <= 122) || (C >= 192 && C <= 255) || C == 140 || C == 156 || C == 159;
}

/** iswpunct of msvcr80: its table below U+0100, GetStringTypeW C1_PUNCT above (Windows 11, 91 ranges). */
