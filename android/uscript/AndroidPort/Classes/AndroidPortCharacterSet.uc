/** Whether a field of this CharacterSet takes the UTF-16 unit C. */
static function bool Accepts(int C, byte CharacterSet)
{
    C = C & 65535;
    switch (CharacterSet)
    {
    case 0:
        return C >= 32 && C != 127;
    case 1:
        return !IsPunctuation(C);
    case 2:
        return IsAlpha(C);
    case 3:
        return (C >= 48 && C <= 57) || C == 46 || C == 45 || C == 43;
    case 4:
        return IsAlpha(C) || (C >= 48 && C <= 57) || C == 46 || C == 45 || C == 43;
    }
    return false;
}

/** Text without the units a field of this CharacterSet drops while typing. */
static function string Filter(string Text, byte CharacterSet)
{
    local string Result;
    local int Index, Character;
    for (Index = 0; Index < Len(Text); ++Index)
    {
        Character = Asc(Mid(Text, Index, 1));
        if (Accepts(Character, CharacterSet))
            Result $= Mid(Text, Index, 1);
    }
    return Result;
}
